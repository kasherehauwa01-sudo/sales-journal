[Unit]
Description=Sales Journal mTLS CA helper
After=network.target

[Service]
Type=simple
User=sales-mtls
Group=sales-backend
EnvironmentFile=/etc/sales-mtls-helper.env
ExecStart=/usr/bin/python3 /opt/sales-journal/deploy/mtls-helper/service.py
Restart=on-failure
RuntimeDirectory=sales-mtls-helper
RuntimeDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/nginx/sales-mtls /run/sales-mtls-helper /var/lib/sales-mtls-helper

[Install]
WantedBy=multi-user.target
