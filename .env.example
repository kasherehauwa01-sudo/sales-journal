POSTGRES_DB=sales
POSTGRES_USER=sales
POSTGRES_PASSWORD=change-this-long-random-password
BASE_PATH=/vr/sales
VITE_BASE_PATH=/vr/sales/
CORS_ORIGINS=https://kvasmix.ru
BACKEND_PORT=8010
FRONTEND_PORT=8011
LOG_LEVEL=INFO
IMPORT_TEMP_DIR=/tmp/sales-journal-imports
AUTOLOAD_TIMEZONE=Europe/Moscow
CLIENTS_VR_API_URL=https://kvasmix.ru/vr/clients/api
CLIENTS_VR_API_TOKEN=
CALLTRACK_INTEGRATION_TOKEN=
VRCATALOG_API_URL=https://kvasmix.ru/vr/catalog/api
VRCATALOG_API_TOKEN=
PUBLIC_URL=https://kvasmix.ru/vr/sales
# Только scrypt-хеш пароля; открытый пароль в конфигурации не хранится.
SETTINGS_ADMIN_PASSWORD_HASH=
SETTINGS_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
SETTINGS_ADMIN_COOKIE_SECURE=true
MTLS_HELPER_SOCKET=/run/sales-mtls-helper/helper.sock
MTLS_HELPER_SECRET=
MTLS_PROXY_SECRET=
SALES_BACKEND_GID=
